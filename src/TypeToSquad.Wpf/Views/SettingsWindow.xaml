<Window x:Class="TypeToSquad.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypeToSquad 设置"
        Width="560" Height="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF1B1F26"
        Foreground="White"
        FontFamily="Segoe UI"
        FontSize="13"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#CCCCDDEE" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <TabControl Background="Transparent" BorderThickness="0" x:Name="TabHost">

            <!-- ===== Voice ===== -->
            <TabItem Header="语音 (Voice)">
                <StackPanel Margin="10" MaxWidth="480">
                    <TextBlock Text="主语音" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="VoiceCombo" Margin="0,0,0,14" />

                    <TextBlock Text="音量" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Width="44"
                                   TextAlignment="Right" Foreground="#CCCCDDEE" Text="100%" />
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="1"
                                ValueChanged="OnVolumeSliderChanged" />
                    </DockPanel>

                    <TextBlock Text="音高 (Pitch)" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock x:Name="PitchValue" DockPanel.Dock="Right" Width="44"
                                   TextAlignment="Right" Foreground="#CCCCDDEE" Text="1.00" />
                        <Slider x:Name="PitchSlider" Minimum="0" Maximum="2" TickFrequency="0.01"
                                ValueChanged="OnPitchSliderChanged" />
                    </DockPanel>

                    <TextBlock Text="语速 (Rate)" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="RateValue" DockPanel.Dock="Right" Width="44"
                                   TextAlignment="Right" Foreground="#CCCCDDEE" Text="1.00" />
                        <Slider x:Name="RateSlider" Minimum="0.5" Maximum="6" TickFrequency="0.01"
                                ValueChanged="OnRateSliderChanged" />
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <!-- ===== Output ===== -->
            <TabItem Header="输出 (Output)">
                <StackPanel Margin="10" MaxWidth="480">
                    <TextBlock Text="输出设备 (留空 = 系统默认)" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="DeviceCombo" Margin="0,0,0,14" />

                    <TextBlock Text="最大并发音频流" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <TextBlock x:Name="MaxStreamsValue" DockPanel.Dock="Right" Width="44"
                                   TextAlignment="Right" Foreground="#CCCCDDEE" />
                        <Slider x:Name="MaxStreamsSlider" Minimum="1" Maximum="64" TickFrequency="1"
                                ValueChanged="OnMaxStreamsSliderChanged" />
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <!-- ===== Messages ===== -->
            <TabItem Header="消息 (Messages)">
                <StackPanel Margin="10" MaxWidth="480">
                    <TextBlock Text="历史记录槽位" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock x:Name="HistorySlotsValue" DockPanel.Dock="Right" Width="44"
                                   TextAlignment="Right" Foreground="#CCCCDDEE" />
                        <Slider x:Name="HistorySlotsSlider" Minimum="0" Maximum="100" TickFrequency="1"
                                ValueChanged="OnHistorySlotsSliderChanged" />
                    </DockPanel>

                    <TextBlock Text="文本替换最大执行轮数" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock x:Name="ReplacementPassesValue" DockPanel.Dock="Right" Width="44"
                                   TextAlignment="Right" Foreground="#CCCCDDEE" />
                        <Slider x:Name="ReplacementPassesSlider" Minimum="0" Maximum="100" TickFrequency="1"
                                ValueChanged="OnReplacementPassesSliderChanged" />
                    </DockPanel>

                    <TextBlock Text="呼出输入框 (Summon)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SummonHotkeyBox" Height="30" Padding="6,3" Margin="0,0,0,14"
                             IsReadOnly="True"
                             Background="#FF232933" Foreground="White"
                             BorderBrush="#33455566" CaretBrush="White"
                             PreviewKeyDown="OnHotkeyPreviewKeyDown" />

                    <TextBlock Text="停止朗读 (Stop)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="StopHotkeyBox" Height="30" Padding="6,3" Margin="0,0,0,8"
                             IsReadOnly="True"
                             Background="#FF232933" Foreground="White"
                             BorderBrush="#33455566" CaretBrush="White"
                             PreviewKeyDown="OnHotkeyPreviewKeyDown" />

                    <TextBlock Foreground="#8899AABB" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="点击输入框后按下新的组合键即可修改；Backspace/Delete 清除 = 禁用该热键；Esc 取消修改。输入框内的 Enter/Esc 为固定操作。" />
                </StackPanel>
            </TabItem>

            <!-- ===== Text Replacements ===== -->
            <TabItem Header="文本替换 (Replacements)">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Top" Foreground="#CCCCDDEE" TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Text="正则表达式 → 替换文本。按顺序在朗读前应用。例如：&quot;btw&quot; → &quot;by the way&quot;" />
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,8,0,0">
                        <Button x:Name="AddReplacementButton" Content="添加" Height="28" Margin="0,0,4,0"
                                Click="OnAddReplacementClicked" />
                        <Button x:Name="RemoveReplacementButton" Content="删除选中" Height="28" Margin="4,0,0,0"
                                Click="OnRemoveReplacementClicked" />
                    </UniformGrid>
                    <DataGrid x:Name="ReplacementsGrid"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              CanUserAddRows="False"
                              CanUserDeleteRows="True"
                              SelectionMode="Single"
                              Background="#FF232933"
                              Foreground="White"
                              RowBackground="#FF232933"
                              AlternatingRowBackground="#FF1F252D"
                              BorderThickness="0"
                              ColumnHeaderHeight="28">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF2A3242" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="Normal" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="White" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF3A4A5F" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="匹配 (Regex)" Binding="{Binding Pattern}"
                                                Width="*" />
                            <DataGridTextColumn Header="替换为" Binding="{Binding Replacement}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
